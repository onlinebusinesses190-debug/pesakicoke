# =============================================================
# PESAKI SERVER ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# =============================================================

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Upstash Redis ─────────────────────────────────────────────
UPSTASH_REDIS_URL=your-upstash-redis-url
UPSTASH_REDIS_TOKEN=your-upstash-redis-token

# ── Server Config ─────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ── PESAKI Forex ──────────────────────────────────────────────
# Set to "true" to enable real-money trading on the /forex endpoints.
# When unset or false, live accounts are refused with a 403 so no real
# funds can ever reach the Forex module until the deployment is explicitly
# marked ready for real trading.
PESAKI_FX_REAL_ENABLED=true

# Leverage used for real-money margin calculations (default: 10 = 1:10).
PESAKI_FX_LEVERAGE=10

# Minimum committed trade amount in KSh (default: 100).
PESAKI_FX_MIN_TRADE_AMOUNT=100

# ── M-Pesa / Safaricom Daraja ─────────────────────────────────
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=your-shortcode
MPESA_TILL_NUMBER=your-till-number
MPESA_PASSKEY=your-passkey
MPESA_ENV=sandbox
MPESA_CALLBACK_URL=http://localhost:4000

# ── RapidAPI (NSE / Forex data) ───────────────────────────────
RAPIDAPI_KEY=your-rapidapi-key
RAPIDAPI_HOST=your-rapidapi-host

# ── Palpluss B2C Withdrawals ──────────────────────────────────
PALPLUSS_API_KEY=your-palpluss-api-key
PALPLUSS_API_URL=https://api.palpluss.com/v1
